			if ag then
				ag.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, col),
					ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
				})
			end
			return col
		end

		local function bindDrag(track, onMove)
			local dragging = false
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					onMove(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if not dragging then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch then
					onMove(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)
		end

		bindDrag(svBox, function(input)
			local relX = (input.Position.X - svBox.AbsolutePosition.X) / math.max(svBox.AbsoluteSize.X, 1)
			local relY = (input.Position.Y - svBox.AbsolutePosition.Y) / math.max(svBox.AbsoluteSize.Y, 1)
			s = math.clamp(relX, 0, 1)
			v = 1 - math.clamp(relY, 0, 1)
			refreshFromHSV()
		end)

		bindDrag(hueTrack, function(input)
			local relY = (input.Position.Y - hueTrack.AbsolutePosition.Y) / math.max(hueTrack.AbsoluteSize.Y, 1)
			h = math.clamp(relY, 0, 1)
			refreshFromHSV()
		end)

		bindDrag(alphaTrack, function(input)
			local relY = (input.Position.Y - alphaTrack.AbsolutePosition.Y) / math.max(alphaTrack.AbsoluteSize.Y, 1)
			a = 1 - math.clamp(relY, 0, 1)
			refreshFromHSV()
		end)

		hexBox.FocusLost:Connect(function()
			local col = hexToColor(hexBox.Text)
			if col then
				h, s, v = Color3.toHSV(col)
				refreshFromHSV()
			end
		end)

		local function rgbFocus(box, channel)
			box.FocusLost:Connect(function()
				local n = tonumber((box.Text or ""):match("%d+"))
				if not n then return end
				n = math.clamp(n, 0, 255) / 255
				local col = Color3.fromHSV(h, s, v)
				local r, g, b = col.R, col.G, col.B
				if channel == "r" then r = n elseif channel == "g" then g = n else b = n end
				h, s, v = Color3.toHSV(Color3.new(r, g, b))
				refreshFromHSV()
			end)
		end
		rgbFocus(rBox, "r")
		rgbFocus(gBox, "g")
		rgbFocus(bBox, "b")
		aBox.FocusLost:Connect(function()
			local n = tonumber((aBox.Text or ""):match("%d+"))
			if not n then return end
			a = math.clamp(n, 0, 100) / 100
			refreshFromHSV()
		end)

		local cancelBtn = new("TextButton", {
			Text = "Cancel",
			Size = UDim2.fromOffset(160, 34),
			Position = UDim2.fromOffset(18, 248),
			BackgroundColor3 = Color3.fromRGB(50, 50, 58),
			TextColor3 = COLORS.text,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			AutoButtonColor = false,
			ZIndex = 323,
			Parent = modal,
		}, { corner(10) })

		local applyBtn = new("TextButton", {
			Text = "Apply",
			Size = UDim2.fromOffset(160, 34),
			Position = UDim2.fromOffset(200, 248),
			BackgroundColor3 = Color3.fromRGB(90, 95, 110),
			TextColor3 = COLORS.text,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			AutoButtonColor = false,
			ZIndex = 323,
			Parent = modal,
		}, { corner(10) })

		local function closePicker(apply)
			if apply then
				current = Color3.fromHSV(h, s, v)
				alpha = a
				swatch.BackgroundColor3 = current
				task.spawn(callback, current, alpha)
			end
			pickerOpen = false
			playModalOut(overlay, modal, function()
				overlay:Destroy()
			end)
		end

		cancelBtn.MouseButton1Click:Connect(function()
			closePicker(false)
		end)
		applyBtn.MouseButton1Click:Connect(function()
			closePicker(true)
		end)
		overlay.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = input.Position
				local mPos = modal.AbsolutePosition
				local mSize = modal.AbsoluteSize
				if pos.X < mPos.X or pos.X > mPos.X + mSize.X
					or pos.Y < mPos.Y or pos.Y > mPos.Y + mSize.Y then
					closePicker(false)
				end
			end
		end)

		refreshFromHSV()
	end

	swatch.MouseButton1Click:Connect(openPicker)

	local api = {
		Set = function(_, c, al)
			if typeof(c) == "Color3" then
				current = c
				swatch.BackgroundColor3 = c
			end
			if type(al) == "number" then alpha = al end
		end,
		Get = function() return current, alpha end,
	}
	registerFlag(flag, function()
		return { R = current.R, G = current.G, B = current.B, A = alpha }
	end, function(v)
		if type(v) == "table" then
			current = Color3.new(v.R or 0, v.G or 0, v.B or 0)
			alpha = v.A or 1
			swatch.BackgroundColor3 = current
			task.spawn(callback, current, alpha)
		end
	end)
	return api
end

