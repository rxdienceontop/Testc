local function findMainFrame(inst)
	local cur = inst
	while cur do
		if cur.Name == "MainFrame" then return cur end
		cur = cur.Parent
	end
	return nil
end

local function formatDropdownValue(selected, multi)
	if multi then
		if type(selected) ~= "table" or #selected == 0 then return "None" end
		if #selected == 1 then return tostring(selected[1]) end
		return tostring(selected[1]) .. " +" .. tostring(#selected - 1)
	end
	return tostring(selected or "None")
end

local function createDropdown(section, opts)
	opts = opts or {}
	local name = opts.Name or "Dropdown"
	local options = opts.Options or {}
	local multi = opts.Multi == true
	local callback = opts.Callback or function() end
	local flag = resolveFlag(section, opts.FlagCfg)

	local selected
	if multi then
		if type(opts.Default) == "table" then
			selected = table.clone(opts.Default)
		elseif opts.Default ~= nil then
			selected = { opts.Default }
		else
			selected = {}
		end
	else
		selected = opts.Default or (options[1] or "")
	end

	local shell = makeElementShell(section._list, 42, name)

	brightLabel({
		Text = name,
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -130, 1, 0),
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = shell,
	})

	local box = new("Frame", {
		Size = UDim2.fromOffset(100, 28),
		Position = UDim2.new(1, -116, 0.5, -14),
		BackgroundColor3 = COLORS.inputBg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = shell,
	}, { corner(7), stroke(COLORS.stroke, 1) })

	local valueLbl = dimLabel({
		Text = formatDropdownValue(selected, multi),
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = box,
	})

	dimLabel({
		Text = "v",
		Position = UDim2.new(1, -20, 0, 0),
		Size = UDim2.fromOffset(18, 28),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = box,
	})

	local overlay = nil
	local pending = nil

	local function isSelected(opt)
		if multi then
			for _, v in ipairs(pending or {}) do
				if v == opt then return true end
			end
			return false
		end
		return pending == opt
	end

	local function togglePending(opt)
		if not multi then
			pending = opt
			return
		end
		for i, v in ipairs(pending) do
			if v == opt then
				table.remove(pending, i)
				return
			end
		end
		table.insert(pending, opt)
	end

	local function closeModal()
		if overlay then
			overlay:Destroy()
			overlay = nil
		end
		pending = nil
	end

	local function openModal()
		if overlay then return end
		local main = findMainFrame(shell)
		if not main then return end

		if multi then
			pending = table.clone(selected)
		else
			pending = selected
		end

		overlay = new("Frame", {
			Name = "DropdownOverlay",
