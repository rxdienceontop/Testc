local ConfigFlags = {}
local MODAL_TWEEN_IN = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local MODAL_TWEEN_OUT = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

local function playModalIn(overlay, modal)
	overlay.BackgroundTransparency = 1
	local scale = modal:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = modal
	end
	scale.Scale = 0.92
	TweenService:Create(overlay, MODAL_TWEEN_IN, { BackgroundTransparency = 0.45 }):Play()
	TweenService:Create(scale, MODAL_TWEEN_IN, { Scale = 1 }):Play()
end

local function playModalOut(overlay, modal, onDone)
	local scale = modal:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Scale = 1
		scale.Parent = modal
	end
	local t1 = TweenService:Create(overlay, MODAL_TWEEN_OUT, { BackgroundTransparency = 1 })
	local t2 = TweenService:Create(scale, MODAL_TWEEN_OUT, { Scale = 0.92 })
	t1:Play()
	t2:Play()
	t2.Completed:Connect(function()
		if onDone then onDone() end
	end)
end

local function registerFlag(flag, getFn, setFn)
	if type(flag) ~= "string" or flag == "" then return end
	ConfigFlags[flag] = { Get = getFn, Set = setFn }
end

local function resolveFlag(section, flag)
	if not section or not section._configable then return nil end
	if type(flag) ~= "string" or flag == "" then return nil end
	return flag
end

local function getAllFlagValues()
	local t = {}
	for flag, api in pairs(ConfigFlags) do
		local ok, val = pcall(api.Get)
		if ok then t[flag] = val end
	end
	return t
end

local function applyFlagValues(data)
	if type(data) ~= "table" then return end
	for flag, val in pairs(data) do
		local api = ConfigFlags[flag]
		if api then
			pcall(api.Set, val)
		end
	end
end

local function makeElementShell(parent, height, searchName)
	local order = 0
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA("Frame") then
			order = order + 1
		end
	end

	local shell = new("Frame", {
		Size = UDim2.new(1, 0, 0, height or 48),
		BackgroundColor3 = COLORS.elementBg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = order,
		Parent = parent,
	}, { corner(9) })

	new("Frame", {
		Size = UDim2.new(0, 3, 1, -12),
		Position = UDim2.fromOffset(0, 6),
		BackgroundColor3 = COLORS.sectionBar,
		BorderSizePixel = 0,
		Parent = shell,
	}, { corner(2) })

	shell:SetAttribute("SearchName", string.lower(tostring(searchName or "")))
	shell:SetAttribute("OrigOrder", order)
	return shell
end

local function createToggle(section, opts)
	opts = opts or {}
	local name = opts.Name or "Toggle"
	local default = opts.Default == true
	local callback = opts.Callback or function() end
	local flag = resolveFlag(section, opts.FlagCfg)

	local shell = makeElementShell(section._list, 42, name)
	local state = default

	brightLabel({
		Text = name,
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -76, 1, 0),
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = shell,
	})

	local track = new("Frame", {
		Size = UDim2.fromOffset(42, 24),
		Position = UDim2.new(1, -56, 0.5, -12),
		BackgroundColor3 = state and COLORS.toggleOn or COLORS.toggleOff,
		BorderSizePixel = 0,
		Parent = shell,
	}, { corner(12) })

	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(9) })

	local btn = new("TextButton", {
		Text = "",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Parent = shell,
	})

	local function setState(v, fire)
		state = v and true or false
		TweenService:Create(track, TweenInfo.new(0.18), {
			BackgroundColor3 = state and COLORS.toggleOn or COLORS.toggleOff,
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
		}):Play()
		if fire ~= false then
			task.spawn(callback, state)
		end
	end

	btn.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	local api = {
		Set = function(_, v) setState(v) end,
		Get = function() return state end,
		SetDefault = function(_, v) setState(v, false) end,
	}
	registerFlag(flag, function() return state end, function(v) setState(v, true) end)
	return api
end

