	local function minimizeToFloat()
		if isMinimized then return end
		isMinimized = true
		mainFrameBaseSize = mainFrame.Size
		local tween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Size = UDim2.fromOffset(0, 0),
			BackgroundTransparency = 1,
		})
		tween:Play()
		tween.Completed:Connect(function()
			mainFrame.Visible = false
		end)

		floatIcon = new("ImageButton", {
			Name = "MonarchFloat",
			Size = UDim2.fromOffset(56, 56),
			Position = floatIconPos,
			AnchorPoint = Vector2.new(0, 0),
			BackgroundColor3 = COLORS.panel,
			BackgroundTransparency = 0.15,
			Image = "rbxassetid://90579019647175",
			ScaleType = Enum.ScaleType.Fit,
			AutoButtonColor = false,
			ZIndex = 1000,
			Parent = screenGui,
		}, { corner(14), stroke(COLORS.stroke, 1) })

		local draggingFloat = false
		local didDragFloat = false
		local dragStartF
		local startPosF
		local moveConn, endConn

		floatIcon.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				draggingFloat = true
				didDragFloat = false
				dragStartF = input.Position
				startPosF = floatIcon.Position
			end
		end)

		moveConn = UserInputService.InputChanged:Connect(function(input)
			if not draggingFloat or not floatIcon then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - dragStartF
				if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
					didDragFloat = true
				end
				floatIcon.Position = UDim2.new(
					startPosF.X.Scale, startPosF.X.Offset + delta.X,
					startPosF.Y.Scale, startPosF.Y.Offset + delta.Y
				)
				floatIconPos = floatIcon.Position
			end
		end)

		endConn = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if draggingFloat then
					draggingFloat = false
					if floatIcon then
						floatIconPos = floatIcon.Position
					end
					if not didDragFloat then
						if moveConn then moveConn:Disconnect() end
						if endConn then endConn:Disconnect() end
						restoreFromFloat()
					end
				end
			end
		end)
	end

