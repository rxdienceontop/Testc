		local function parseExpiryDate(str)
			str = tostring(str or ""):gsub("^%s+", ""):gsub("%s+$", "")
			local m, d, y = str:match("^(%d+)/(%d+)/(%d+)$")
			if not m then return nil end
			m, d, y = tonumber(m), tonumber(d), tonumber(y)
			if not m or not d or not y then return nil end
			if y < 100 then y = 2000 + y end
			return { month = m, day = d, year = y }
		end

		local function isExpired(expiresStr)
			local exp = parseExpiryDate(expiresStr)
			if not exp then return true end
			local now = os.date("*t")
			if now.year > exp.year then return true end
			if now.year < exp.year then return false end
			if now.month > exp.month then return true end
			if now.month < exp.month then return false end
			if now.day >= exp.day then return true end
			return false
		end

		local function saveKeyData(username, key, expires)
			ensureMonarchFolder()
			pcall(function()
				if writefile then
					writefile(KEY_FILE, table.concat({
						tostring(username or ""),
						tostring(key or ""),
						tostring(expires or ""),
					}, "\n"))
				end
			end)
		end

		local function clearKeyData()
			pcall(function()
				if isfile and isfile(KEY_FILE) and delfile then
					delfile(KEY_FILE)
				elseif writefile then
					writefile(KEY_FILE, "")
				end
			end)
		end

		local function loadKeyData()
			local data = { Username = "", Key = "", Expires = "" }
			local ok, body = pcall(function()
				if isfile and isfile(KEY_FILE) and readfile then
					return readfile(KEY_FILE)
				end
				return nil
			end)
			if not ok or type(body) ~= "string" or body == "" then
				return nil
			end
			local lines = {}
			for line in body:gmatch("[^\r\n]+") do
				table.insert(lines, line)
			end
			if #lines < 2 then return nil end
			data.Username = lines[1] or ""
			data.Key = lines[2] or ""
			data.Expires = lines[3] or ""
			if data.Key == "" then return nil end
			return data
		end

		local function fetchKeyEntries()
			local entries = {}
			local ok, body = pcall(function()
				return game:HttpGet(KEY_LIST_URL)
			end)
			if not ok or type(body) ~= "string" or body == "" or body:lower():find("not found") then
				return entries
			end
			for line in body:gmatch("[^\r\n]+") do
				local u, k, e = line:match('%{%s*"([^"]*)"%s*,%s*"([^"]*)"%s*,%s*"([^"]*)"%s*%}')
				if u and k then
					table.insert(entries, {
						Username = u,
						Key = k,
						Expires = (e or ""):gsub("^%s+", ""):gsub("%s+$", ""),
					})
				end
			end
			return entries
		end

		local function validateAgainstList(username, key, entries)
			local matched = nil
			local keyOnly = false
			local userOnly = false
			local localName = string.lower(tostring(username or ""))
			for _, e in ipairs(entries) do
				local userOk = string.lower(e.Username) == localName
				local keyOk = e.Key == key
				if userOk and keyOk then
					matched = e
					break
				elseif keyOk then
					keyOnly = true
				elseif userOk then
					userOnly = true
				end
			end
			return matched, keyOnly, userOnly
		end

