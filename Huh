	local function fetchUpdateBody()
		local ok, body = pcall(function()
			return game:HttpGet(UPDATE_URL)
		end)
		if not ok or type(body) ~= "string" then return nil end
		if body:lower():find("<!doctype html") or body:lower():find("not found") then return nil end
		return body
	end

	local function parseUpdateData(body)
		if type(body) ~= "string" or body == "" then return nil end
		local src = body
		if not src:find("^%s*return") then
			src = "return " .. src
		end
		local fn = nil
		pcall(function()
			fn = loadstring(src)
		end)
		if type(fn) ~= "function" then return nil end
		local ok, data = pcall(fn)
		if ok and type(data) == "table" then return data end
		return nil
	end

	local function readUpdateCache()
		local ok, body = pcall(function()
			if isfile and isfile(UPDATE_CACHE) and readfile then
				return readfile(UPDATE_CACHE)
			end
			return nil
		end)
		if ok and type(body) == "string" then return body end
		return nil
	end

	local function writeUpdateCache(body)
		pcall(function()
			if isfolder and not isfolder("Monarch") then makefolder("Monarch") end
			if writefile then writefile(UPDATE_CACHE, body) end
		end)
	end

