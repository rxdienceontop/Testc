				if isfolder and not isfolder(AUDIO_DIR) then makefolder(AUDIO_DIR) end
				if isfolder and not isfolder(TRASH_DIR) then makefolder(TRASH_DIR) end
			end)
		end

		local function loadFavorites()
			favorites = {}
			pcall(function()
				if isfile and isfile(FAV_FILE) then
					local raw = readfile(FAV_FILE)
					for line in string.gmatch(raw, "[^\r\n]+") do
						if line ~= "" then favorites[line] = true end
					end
				end
			end)
		end

		local function saveFavorites()
			pcall(function()
				local lines = {}
				for k in pairs(favorites) do table.insert(lines, k) end
				writefile(FAV_FILE, table.concat(lines, "\n"))
			end)
		end

		local function basename(path)
			return path:match("([^/\\]+)$") or path
		end

		local function stripExt(name)
			return name:gsub("%.[^%.]+$", "")
		end

		local function scanTracks()
			ensureFolders()
			loadFavorites()
			tracks = {}
			pcall(function()
				if not listfiles then return end
				for _, path in ipairs(listfiles(AUDIO_DIR)) do
					local name = basename(path)
					if name:sub(1, 1) ~= "." and (name:lower():match("%.mp3$") or name:lower():match("%.ogg$") or name:lower():match("%.wav$")) then
						local asset = nil
						pcall(function()
							if getcustomasset then
								asset = getcustomasset(path)
							end
						end)
						table.insert(tracks, {
							path = path,
							name = stripExt(name),
							file = name,
							asset = asset,
							date = 0,
							duration = 0,
						})
					end
				end
			end)
			sortTracks()
		end

		function sortTracks()
			table.sort(tracks, function(a, b)
				if sortMode == "Date" then
					return (a.date or 0) > (b.date or 0)
				elseif sortMode == "Timestamp" then
					return (a.duration or 0) > (b.duration or 0)
				end
				return (a.name or "") < (b.name or "")
			end)
		end

