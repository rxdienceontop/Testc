	function window:_switchSidebar(target)
		if self._sidebarSwitching or self._activeSidebar == target then return end
		self._sidebarSwitching = true

		if target == "general" then
			self:_ensureGeneralPage()
		elseif target == "external" then
			self:_ensureExternalPage()
		elseif target == "visuals" then
			self:_ensureVisualsPage()
		elseif target == "premium" then
			self:_ensurePremiumPage()
		end

		local outPage = getPageForSidebar and getPageForSidebar(self._activeSidebar)
		local inPage = getPageForSidebar and getPageForSidebar(target)
		if not inPage then
			self._sidebarSwitching = false
			return
		end

		inPage.Visible = true
		inPage.GroupTransparency = 1
		inPage.Position = UDim2.new(0, 0, 0, 0)

		if outPage then
			TweenService:Create(outPage, TAB_TWEEN_INFO, {
				GroupTransparency = 1,
			}):Play()
		end

		local inTween = TweenService:Create(inPage, TAB_TWEEN_INFO, {
			GroupTransparency = 0,
		})
		inTween:Play()

		if setSidebarBtnActive then
			setSidebarBtnActive(homeTabBtn, target == "home")
			setSidebarBtnActive(generalTabBtn, target == "general")
			setSidebarBtnActive(externalTabBtn, target == "external")
			setSidebarBtnActive(visualsTabBtn, target == "visuals")
			setSidebarBtnActive(premiumTabBtn, target == "premium")
		end
		self._activeSidebar = target

		if target ~= "general" and self._searchBox then
			self._searchBox.Text = ""
			if self._activeLibTab then
				self._activeLibTab:_applySearch("")
			end
		end

		task.defer(function()
			if target == "general" then
				if animateBottomIconsIn then animateBottomIconsIn(self) end
				if self._activeLibTab and animateSidePanels then
					animateSidePanels(self._activeLibTab, "in")
				end
			elseif target == "home" then
				if homeFeatureBtns and homeFeatureBtns.playHomeEntrance then
					homeFeatureBtns.playHomeEntrance()
				end
			elseif target == "external" then
				local mb = self._externalModeBar
				if mb then
					local base = rememberPos(mb)
					mb.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset - 55)
					TweenService:Create(mb, COL_SLIDE, { Position = base }):Play()
				end
				local root = self._externalPage
				if root then
					for _, child in ipairs(root:GetChildren()) do
						if child:IsA("CanvasGroup") then
							local base = rememberPos(child)
							child.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + 50)
							TweenService:Create(child, COL_SLIDE, { Position = base }):Play()
						end
					end
				end
			elseif target == "visuals" then
				if self._visualsTabObj then
					if animateSidePanels then animateSidePanels(self._visualsTabObj, "in") end
				end
			elseif target == "premium" then
				local page = getPageForSidebar(target)
				if page then
					for _, child in ipairs(page:GetChildren()) do
						if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIGradient") then
							-- always animate from locked base so tab never drifts downward
							local base = lockBasePos(child)
							if base then
								child.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + 50)
								TweenService:Create(child, COL_SLIDE, { Position = base }):Play()
							end
						end
					end
				end
			end
		end)

		inTween.Completed:Connect(function()
			if outPage then
				outPage.Visible = false
			end
			self._sidebarSwitching = false
		end)
	end

	local COL_SLIDE = TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local COL_SLIDE_OUT = TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	local SIDE_OFF = 180
	local activeSideTweens = {}

	local function cancelSideTweens(obj)
		if not obj then return end
		local list = activeSideTweens[obj]
		if list then
			for _, tw in ipairs(list) do
				pcall(function() tw:Cancel() end)
			end
			activeSideTweens[obj] = nil
		end
	end

	local function playSideTween(obj, info, goals)
		if not obj then return nil end
		cancelSideTweens(obj)
		local tw = TweenService:Create(obj, info, goals)
		activeSideTweens[obj] = { tw }
		tw:Play()
		return tw
	end

	local function lockBasePos(obj, forced)
		if not obj then return nil end
		if forced or not obj:GetAttribute("_BaseLocked") then
			local p = forced or obj.Position
			obj:SetAttribute("_BasePosX", p.X.Offset)
			obj:SetAttribute("_BasePosY", p.Y.Offset)
			obj:SetAttribute("_BaseScaleX", p.X.Scale)
			obj:SetAttribute("_BaseScaleY", p.Y.Scale)
			obj:SetAttribute("_BaseLocked", true)
		end
		return UDim2.new(
			obj:GetAttribute("_BaseScaleX") or 0,
			obj:GetAttribute("_BasePosX") or 0,
			obj:GetAttribute("_BaseScaleY") or 0,
			obj:GetAttribute("_BasePosY") or 0
		)
	end

	local function rememberPos(obj)
		return lockBasePos(obj, nil)
	end

	local function getSidePair(tabObj)
		if not tabObj then return nil, nil end
		return tabObj._leftScroll or tabObj._scroll, tabObj._rightScroll
	end

	local function snapSideToBase(tabObj)
		local left, right = getSidePair(tabObj)
		if left then
			cancelSideTweens(left)
			left.Position = lockBasePos(left)
		end
		if right then
			cancelSideTweens(right)
			right.Position = lockBasePos(right)
		end
	end

	local function placeSideOff(tabObj)
		local left, right = getSidePair(tabObj)
		if left then
			cancelSideTweens(left)
			local base = lockBasePos(left)
			left.Position = UDim2.new(base.X.Scale, base.X.Offset - SIDE_OFF, base.Y.Scale, base.Y.Offset)
		end
		if right then
			cancelSideTweens(right)
			local base = lockBasePos(right)
			right.Position = UDim2.new(base.X.Scale, base.X.Offset + SIDE_OFF, base.Y.Scale, base.Y.Offset)
		end
	end

	animateSidePanels = function(tabObj, direction)
		if not tabObj then return end
		local left, right = getSidePair(tabObj)
		if direction == "out" then
			if left then
				local base = lockBasePos(left)
				playSideTween(left, COL_SLIDE_OUT, {
					Position = UDim2.new(base.X.Scale, base.X.Offset - SIDE_OFF, base.Y.Scale, base.Y.Offset),
				})
			end
			if right then
				local base = lockBasePos(right)
				playSideTween(right, COL_SLIDE_OUT, {
					Position = UDim2.new(base.X.Scale, base.X.Offset + SIDE_OFF, base.Y.Scale, base.Y.Offset),
				})
			end
			return
		end
		if left then
			local base = lockBasePos(left)
			left.Position = UDim2.new(base.X.Scale, base.X.Offset - SIDE_OFF, base.Y.Scale, base.Y.Offset)
			playSideTween(left, COL_SLIDE, { Position = base })
		end
		if right then
			local base = lockBasePos(right)
			right.Position = UDim2.new(base.X.Scale, base.X.Offset + SIDE_OFF, base.Y.Scale, base.Y.Offset)
			playSideTween(right, COL_SLIDE, { Position = base })
		end
	end

	animateColumnsIn = function(tabObj)
		animateSidePanels(tabObj, "in")
	end

	animateBottomIconsIn = function(window)
		local strip = window._tabIconStrip
		local bar = window._bottomBar
		if bar then
			local base = rememberPos(bar)
			bar.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + 100)
			TweenService:Create(bar, COL_SLIDE, { Position = base }):Play()
		end
		if not strip then return end
		local i = 0
		for _, child in ipairs(strip:GetChildren()) do
			if child:IsA("Frame") then
				i = i + 1
				local base = rememberPos(child)
				child.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset + 44)
				task.delay(0.1 + (i - 1) * 0.055, function()
					if child and child.Parent then
						TweenService:Create(child, COL_SLIDE, { Position = base }):Play()
					end
				end)
			end
		end
	end

	function window:_switchLibSubTab(tabObj)
		if not tabObj then return end
		if self._activeLibTab == tabObj and not self._subTabSwitching then return end

		local outPage = self._activeLibTab and self._activeLibTab._page or nil
		local outTab = self._activeLibTab
		self._subTabSwitching = true

		if outTab and outTab._setIconActive then
			outTab._setIconActive(false)
		end
		if outTab then
			outTab:_applySearch("")
		end
		if self._searchBox then
			self._searchBox.Text = ""
		end

		if outTab and outTab ~= tabObj then
			animateSidePanels(outTab, "out")
		end

		tabObj._page.Visible = true
		tabObj._page.GroupTransparency = 1
		tabObj._page.Position = UDim2.new(0, 0, 0, 0)
		placeSideOff(tabObj)

		if outPage and outPage ~= tabObj._page then
			TweenService:Create(outPage, TAB_TWEEN_INFO, {
				GroupTransparency = 1,
			}):Play()
		end

		local inTween = TweenService:Create(tabObj._page, TAB_TWEEN_INFO, {
			GroupTransparency = 0,
		})
		inTween:Play()

		if tabObj._setIconActive then
			tabObj._setIconActive(true)
		end
		self._activeLibTab = tabObj

		local delayIn = (outTab and outTab ~= tabObj) and 0.2 or 0
		task.delay(delayIn, function()
			if self._activeLibTab == tabObj then
				animateSidePanels(tabObj, "in")
			end
		end)

		local done = false
		local function finish()
			if done then return end
			done = true
			if outPage and outPage ~= tabObj._page then
				outPage.Visible = false
				if outTab then
					snapSideToBase(outTab)
				end
			end
			self._subTabSwitching = false
		end

		inTween.Completed:Connect(finish)
		task.delay(0.55, finish)
		task.delay(delayIn + 0.45, function()
			if self._activeLibTab == tabObj then
				snapSideToBase(tabObj)
			end
		end)
	end

