			premiumActive = false
			premiumExpires = ""
			local saved = loadKeyData()
			if not saved then return false, "none" end
			local localName = tostring(Players.LocalPlayer and Players.LocalPlayer.Name or "")
			if string.lower(saved.Username) ~= string.lower(localName) then
				clearKeyData()
				return false, "user"
			end
			if isExpired(saved.Expires) then
				clearKeyData()
				return false, "expired"
			end
			local entries = fetchKeyEntries()
			local matched = validateAgainstList(localName, saved.Key, entries)
			if not matched then
				clearKeyData()
				return false, "invalid"
			end
			if isExpired(matched.Expires) then
				clearKeyData()
				return false, "expired"
			end
			premiumActive = true
			premiumExpires = matched.Expires
			if matched.Expires ~= saved.Expires then
				saveKeyData(localName, saved.Key, matched.Expires)
			end
			return true, "ok"
		end

