	local TWEEN_TIME = 0.45
	local barGroups = {}

	local function randomFactor()
		return 0.2 + math.random() * 0.7
	end

	local function makeGroup(xPos)
		local cpuHeight = GRAPH_HEIGHT * randomFactor()
		local ramHeight = GRAPH_HEIGHT * randomFactor()
		local cpuBar = new("Frame", {
			Size = UDim2.fromOffset(barWidth, cpuHeight),
			Position = UDim2.fromOffset(xPos, GRAPH_HEIGHT - cpuHeight),
			BackgroundColor3 = COLORS.cyan,
