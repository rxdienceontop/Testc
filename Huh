	local function captureLockedTransparencies()
		if uiTransparencyCaptured then return end
		uiTransparencyCaptured = true
		uiTransparencyLocked = {}
		for _, d in ipairs(mainFrame:GetDescendants()) do
			if d:IsA("GuiObject") then
				local lock = {}
				if d.BackgroundTransparency >= 0.99 then lock.bg = true end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					if d.TextTransparency >= 0.99 then lock.text = true end
				end
				if d:IsA("ImageLabel") or d:IsA("ImageButton") then
					if d.ImageTransparency >= 0.99 then lock.img = true end
				end
				if lock.bg or lock.text or lock.img then
					uiTransparencyLocked[d] = lock
				end
			end
		end
	end

	local function applyUiTransparency(t)
		captureLockedTransparencies()
		t = math.clamp(tonumber(t) or 0, 0, 1)
		for _, d in ipairs(mainFrame:GetDescendants()) do
			if d:IsA("GuiObject") then
				local lock = uiTransparencyLocked[d]
				if d:IsA("ImageLabel") or d:IsA("ImageButton") then
					if not (lock and lock.img) then
						d.ImageTransparency = t
					end
				end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					if not (lock and lock.text) then
						d.TextTransparency = t
					end
				end
				if not (lock and lock.bg) then
					if d.BackgroundTransparency < 0.99 then
						d.BackgroundTransparency = t
					end
				end
			end
		end
		if bgImageLayer and tostring(bgImageLayer.Image or "") ~= "" then
			bgImageLayer.ImageTransparency = t
		end
	end

	local function ensureDirs()
		pcall(function()
			if isfolder and not isfolder("Monarch") then makefolder("Monarch") end
