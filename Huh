			if isfolder and not isfolder(BG_DIR) then makefolder(BG_DIR) end
		end)
	end

	local function listFiles(dir, ext)
		local out = {}
		pcall(function()
			if not listfiles then return end
			for _, f in ipairs(listfiles(dir) or {}) do
				local name = tostring(f):match("([^/\\]+)$") or tostring(f)
				if not ext or name:lower():match("%." .. ext:lower() .. "$") then
					table.insert(out, name)
				end
			end
		end)
		table.sort(out)
		return out
	end

