	local function checkAndShowUpdates(forceOpen, defaultTab)
		task.spawn(function()
			local body = fetchUpdateBody()
			if not body or body == "" then
				return
			end
			local data = parseUpdateData(body)
			if not data then
				return
			end
			local cached = readUpdateCache()
			local changed = (not cached) or (cached ~= body) or (cached == "")
			if changed then
				writeUpdateCache(body)
			end
			if forceOpen or changed then
				openUpdateLogsModal(data, defaultTab)
			end
		end)
	end

