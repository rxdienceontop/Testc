		local function loadTrack(idx)
			if idx < 1 or idx > #tracks then return end
			currentIndex = idx
			local t = tracks[idx]
			trackNameLbl.Text = ellipsize(t.name, 28)
			updateFavIcon()
			if t.asset then
				sound.SoundId = t.asset
			else
				sound.SoundId = ""
			end
			sound.TimePosition = 0
			sound.PlaybackSpeed = playbackSpeed
			sound.Volume = volume
			seekFill.Size = UDim2.new(0, 0, 1, 0)
			timeCur.Text = "0:00"
			timeTotal.Text = "0:00"
			task.spawn(function()
				local t0 = os.clock()
				while sound.TimeLength <= 0 and os.clock() - t0 < 3 do
					task.wait(0.1)
				end
				if sound.TimeLength > 0 then
					t.duration = sound.TimeLength
					timeTotal.Text = fmtTime(sound.TimeLength)
				end
			end)
		end

		local function playCurrent()
			if currentIndex < 1 and #tracks > 0 then
				loadTrack(1)
