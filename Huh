local function createSlider(section, opts)
	opts = opts or {}
	local name = opts.Name or "Slider"
	local settings = opts.SliderSettings or {}
	local minV = settings.Min or 0
	local maxV = settings.Max or 100
	local flag = resolveFlag(section, opts.FlagCfg)
	local decimals = settings.Decimals
	if decimals == nil then
		decimals = (maxV - minV) <= 2 and 2 or 0
	end
	local default = opts.Default
	if default == nil then default = minV end
	default = math.clamp(default, minV, maxV)
	local callback = opts.Callback or function() end

	local function formatVal(v)
		if decimals <= 0 then
			return tostring(math.floor(v + 0.5))
		end
		local mult = 10 ^ decimals
		return string.format("%." .. tostring(decimals) .. "f", math.floor(v * mult + 0.5) / mult)
	end

	local shell = makeElementShell(section._list, 60, name)

	brightLabel({
		Text = name,
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -90, 0, 20),
		TextSize = 14,
		Parent = shell,
	})

	local valueBox = new("Frame", {
		Size = UDim2.fromOffset(48, 24),
		Position = UDim2.new(1, -64, 0, 5),
		BackgroundColor3 = COLORS.inputBg,
		BorderSizePixel = 0,
		Parent = shell,
	}, { corner(6), stroke(COLORS.stroke, 1) })

	local valueLbl = brightLabel({
		Text = formatVal(default),
		Size = UDim2.new(1, 0, 1, 0),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = valueBox,
	})

	local track = new("Frame", {
		Size = UDim2.new(1, -32, 0, 8),
		Position = UDim2.fromOffset(16, 38),
		BackgroundColor3 = Color3.fromRGB(55, 53, 70),
		BorderSizePixel = 0,
		Parent = shell,
	}, { corner(4) })

	local fill = new("Frame", {
		Size = UDim2.new((default - minV) / math.max(maxV - minV, 1e-9), 0, 1, 0),
		BackgroundColor3 = COLORS.accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(4) })

	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 120, 255)),
			ColorSequenceKeypoint.new(1, COLORS.accent),
		}),
		Parent = fill,
	})

	local value = default
	local dragging = false

	local function setValue(v, fire)
		v = math.clamp(v, minV, maxV)
		if decimals > 0 then
			local mult = 10 ^ decimals
			v = math.floor(v * mult + 0.5) / mult
		else
			v = math.floor(v + 0.5)
		end
		value = v
		local pct = (v - minV) / math.max(maxV - minV, 1e-9)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		valueLbl.Text = formatVal(v)
		if fire ~= false then
			task.spawn(callback, value)
		end
	end

	local function updateFromInput(input)
		local rel = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		rel = math.clamp(rel, 0, 1)
		setValue(minV + rel * (maxV - minV))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local api = {
		Set = function(_, v) setValue(v) end,
		Get = function() return value end,
		SetDefault = function(_, v) setValue(v, false) end,
	}
	registerFlag(flag, function() return value end, function(v) setValue(tonumber(v) or v) end)
	return api
end

