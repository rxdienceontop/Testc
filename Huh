	local function setBgFromAsset(kind, idOrPath)
		ensureDirs()
		if kind == "image" then
			if not bgImageLayer then
				bgImageLayer = new("ImageLabel", {
					Name = "CustomBgImage",
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					ScaleType = Enum.ScaleType.Crop,
					ZIndex = 0,
					Parent = mainFrame,
				})
				bgImageLayer.ZIndex = 0
				for _, c in ipairs(mainFrame:GetChildren()) do
					if c:IsA("GuiObject") and c ~= bgImageLayer and c.Name ~= "CustomBgVideo" then
						if c.ZIndex < 1 then c.ZIndex = 1 end
					end
				end
			end
			local img = ""
			local id = tostring(idOrPath or "")
			if id:match("^%d+$") then
				img = "rbxassetid://" .. id
			elseif id ~= "" then
				pcall(function()
					if getcustomasset then
						local path = id
						if not path:find("Monarch") then path = BG_DIR .. "/" .. id end
						local asset = getcustomasset(path)
						if type(asset) == "string" then
							img = asset
						end
					end
				end)
			end
			if type(img) == "string" then
				bgImageLayer.Image = img
			end
			if bgVideoLayer then bgVideoLayer.Visible = false end
		elseif kind == "video" then
			if not bgVideoLayer then
				bgVideoLayer = Instance.new("VideoFrame")
				bgVideoLayer.Name = "CustomBgVideo"
				bgVideoLayer.Size = UDim2.new(1, 0, 1, 0)
				bgVideoLayer.BackgroundTransparency = 1
				bgVideoLayer.ZIndex = 0
				bgVideoLayer.Looped = true
				bgVideoLayer.Volume = 0
				bgVideoLayer.Parent = mainFrame
			end
			local src = ""
			local id = tostring(idOrPath or "")
			if id:match("^%d+$") then
				src = "rbxassetid://" .. id
			elseif id ~= "" then
				pcall(function()
					if getcustomasset then
						local path = id
						if not path:find("Monarch") then path = BG_DIR .. "/" .. id end
						local asset = getcustomasset(path)
						if type(asset) == "string" then
							src = asset
						end
					end
				end)
			end
			if type(src) == "string" then
				bgVideoLayer.Video = src
			end
			if bgImageLayer then bgImageLayer.Visible = false end
		end
		applyBackground()
	end

	local function getConfigNames()
		ensureDirs()
		local names = {}
		local files = listFiles(CONFIG_DIR, "json")
		for _, n in ipairs(files) do
			local bare = n:gsub("%.json$", "")
			if bare ~= "" then
				table.insert(names, bare)
			end
		end
		if #names == 0 then
			table.insert(names, "None")
		end
		return names
	end

	local function saveConfig(name, silent)
		if not name or name == "" or name == "None" then
			if not silent then
				Notify("Config", "Enter a valid config name to save.")
			end
			return false
		end
		ensureDirs()
		local flags = getAllFlagValues()
		local payload = "{}"
		local encodeOk = pcall(function()
			payload = HttpService:JSONEncode(flags)
		end)
		if not encodeOk then
			if not silent then
				Notify("Config", "Failed to encode config.")
			end
			return false
		end
		payload = tostring(payload):gsub("[\r\n]+", "")
		local ok = pcall(function()
			if writefile then
				writefile(CONFIG_DIR .. "/" .. name .. ".json", payload)
			end
		end)
		if ok then
			currentConfigName = name
			if not silent then
				Notify("Config Saved", "Saved <b>" .. tostring(name) .. "</b> successfully.")
			end
		elseif not silent then
			Notify("Config", "Failed to save <b>" .. tostring(name) .. "</b>.")
		end
		return ok
	end

	local function loadConfig(name, silent)
		if not name or name == "" or name == "None" then
			if not silent then
				Notify("Config", "Select a config to load.")
			end
			return false
		end
		ensureDirs()
		local path = CONFIG_DIR .. "/" .. name .. ".json"
		local ok, body = pcall(function()
			if isfile and isfile(path) and readfile then
				return readfile(path)
			end
			return nil
		end)
		if not ok or type(body) ~= "string" or body == "" then
			if not silent then
				Notify("Config", "Could not read <b>" .. tostring(name) .. "</b>.")
			end
			return false
		end
		local decoded = nil
		local decodeOk = pcall(function()
			decoded = HttpService:JSONDecode(body)
		end)
		if not decodeOk or type(decoded) ~= "table" then
			if not silent then
				Notify("Config", "Invalid JSON in <b>" .. tostring(name) .. "</b>.")
			end
			return false
		end
		applyFlagValues(decoded)
		currentConfigName = name
		if not silent then
			Notify("Config Loaded", "Loaded <b>" .. tostring(name) .. "</b> successfully.")
		end
		return true
	end

	local function deleteConfig(name)
		if not name or name == "" or name == "None" then return end
		pcall(function()
			local path = CONFIG_DIR .. "/" .. name .. ".json"
			if isfile and isfile(path) and delfile then
				delfile(path)
			end
		end)
		if currentConfigName == name then currentConfigName = "" end
	end

	local function renameConfig(oldName, newName)
		if not oldName or not newName or oldName == "" or newName == "" then return false end
		if oldName == "None" or newName == "None" then return false end
		local ok = pcall(function()
			local oldPath = CONFIG_DIR .. "/" .. oldName .. ".json"
			local newPath = CONFIG_DIR .. "/" .. newName .. ".json"
			if isfile and isfile(oldPath) and readfile and writefile then
				writefile(newPath, readfile(oldPath))
				if delfile then delfile(oldPath) end
			end
		end)
		if ok and currentConfigName == oldName then currentConfigName = newName end
		return ok
	end

