		}, { corner(2) })
		local ramBar = new("Frame", {
			Size = UDim2.fromOffset(barWidth, ramHeight),
			Position = UDim2.fromOffset(xPos + barWidth + 2, GRAPH_HEIGHT - ramHeight),
			BackgroundColor3 = COLORS.accent,
			BorderSizePixel = 0,
			Parent = graphArea,
		}, { corner(2) })
		return { cpu = cpuBar, ram = ramBar, x = xPos }
	end

	for i = 0, BAR_COUNT - 1 do
		table.insert(barGroups, makeGroup(i * groupWidth))
	end

	task.spawn(function()
		while graphArea and graphArea.Parent do
			task.wait(SCROLL_INTERVAL)
			if not graphArea.Parent then break end
			local newGroup = makeGroup(BAR_COUNT * groupWidth)
			table.insert(barGroups, newGroup)
			for _, group in ipairs(barGroups) do
				local newX = group.x - groupWidth
				group.x = newX
				TweenService:Create(group.cpu, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
					Position = UDim2.fromOffset(newX, group.cpu.Position.Y.Offset),
				}):Play()
				TweenService:Create(group.ram, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
					Position = UDim2.fromOffset(newX + barWidth + 2, group.ram.Position.Y.Offset),
				}):Play()
			end
			task.delay(TWEEN_TIME, function()
				local removed = table.remove(barGroups, 1)
				if removed then
