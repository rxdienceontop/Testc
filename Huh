	local rightScroll = new("ScrollingFrame", {
		Size = UDim2.new(0.5, -(OUTER_X + COL_GAP / 2), 1, -(OUTER_Y * 2)),
		Position = UDim2.new(0.5, COL_GAP / 2, 0, OUTER_Y),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = COLORS.accent,
		ScrollBarImageTransparency = 0.2,
		ClipsDescendants = true,
		Parent = page,
	}, { pad(2, 2, SB, 2) })

	local leftCol = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = leftScroll,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = leftCol,
	})
	new("UISizeConstraint", {
		MinSize = Vector2.new(0, 0),
		Parent = leftCol,
	})

	local rightCol = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = rightScroll,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = rightCol,
	})

	local tabObj = {
		_page = page,
		_scroll = leftScroll, 
		_leftScroll = leftScroll,
		_rightScroll = rightScroll,
		_leftCol = leftCol,
		_rightCol = rightCol,
		_iconBtn = iconBtn,
		_iconImg = iconImg,
		_button = clickArea,
		_name = name,
		_icon = icon,
		_elements = {},
		_configable = true,
	}

	function tabObj:Section(o)
		return createSection(self, o)
	end

	function tabObj:_collectElements()
		local list = {}
		for _, col in ipairs({ self._leftCol, self._rightCol }) do
			for _, sectionFrame in ipairs(col:GetChildren()) do
				if sectionFrame:IsA("Frame") then
					for _, child in ipairs(sectionFrame:GetDescendants()) do
						if child:IsA("Frame") and child:GetAttribute("SearchName") ~= nil then
							table.insert(list, {
								frame = child,
								parent = child.Parent,
								order = child:GetAttribute("OrigOrder") or child.LayoutOrder,
								name = child:GetAttribute("SearchName") or "",
							})
						end
					end
				end
			end
		end
		self._elements = list
		return list
	end

	function tabObj:_applySearch(query)
		query = string.lower(tostring(query or "")):gsub("^%s+", ""):gsub("%s+$", "")
		local elems = self:_collectElements()
		if query == "" then
			for _, e in ipairs(elems) do
				e.frame.Visible = true
				e.frame.LayoutOrder = e.order
			end
			return
		end
		for _, e in ipairs(elems) do
			local match = string.find(e.name, query, 1, true) ~= nil
			e.frame.Visible = match
		end
	end

	table.insert(window._libTabs, tabObj)

	if leftScroll then
		leftScroll:SetAttribute("_BasePosX", leftScroll.Position.X.Offset)
		leftScroll:SetAttribute("_BasePosY", leftScroll.Position.Y.Offset)
		leftScroll:SetAttribute("_BaseScaleX", leftScroll.Position.X.Scale)
		leftScroll:SetAttribute("_BaseScaleY", leftScroll.Position.Y.Scale)
		leftScroll:SetAttribute("_BaseLocked", true)
	end
	if rightScroll then
		rightScroll:SetAttribute("_BasePosX", rightScroll.Position.X.Offset)
		rightScroll:SetAttribute("_BasePosY", rightScroll.Position.Y.Offset)
		rightScroll:SetAttribute("_BaseScaleX", rightScroll.Position.X.Scale)
		rightScroll:SetAttribute("_BaseScaleY", rightScroll.Position.Y.Scale)
		rightScroll:SetAttribute("_BaseLocked", true)
	end

	local function setIconActive(active)
		if active then
			iconBtn.BackgroundTransparency = 0
			iconBtn.BackgroundColor3 = COLORS.accent
			iconImg.ImageColor3 = Color3.new(1, 1, 1)
		else
			iconBtn.BackgroundTransparency = 1
			iconImg.ImageColor3 = COLORS.dim
		end
	end
	tabObj._setIconActive = setIconActive

	clickArea.MouseButton1Click:Connect(function()
		window:_switchLibSubTab(tabObj)
	end)

	if #window._libTabs == 1 then
		task.defer(function()
			window:_switchLibSubTab(tabObj)
		end)
	end

	return tabObj
end

