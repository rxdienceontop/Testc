local function createLabel(section, opts)
	opts = opts or {}
	local name = opts.Name or opts.Title or "Label"
	local desc = opts.Desc or ""

	local function plainText(s)
		local str = tostring(s or "")
		str = str:gsub("<[^>]+>", "")
		str = str:gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&amp;", "&"):gsub("&quot;", '"'):gsub("&apos;", "'")
		return str
	end

	local shell = makeElementShell(section._list, 42, plainText(name))

	local titleLbl = brightLabel({
		Text = name,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -24, 0, 18),
		TextSize = 14,
		RichText = true,
		Parent = shell,
	})

	local descLbl = dimLabel({
		Text = desc,
		Position = UDim2.fromOffset(16, 28),
		Size = UDim2.new(1, -24, 0, 0),
		TextSize = 13,
		Font = Enum.Font.Gotham,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		RichText = true,
		Parent = shell,
	})

	-- Dummy used for accurate rich-text height measurement
	local dummyLbl = Instance.new("TextLabel")
	dummyLbl.Visible = false
	dummyLbl.BackgroundTransparency = 1
	dummyLbl.TextWrapped = true
	dummyLbl.RichText = true
	dummyLbl.TextSize = 13
	dummyLbl.Font = Enum.Font.Gotham
	dummyLbl.Parent = shell

	local function measureHeight(text, width)
		local plain = plainText(text)
		if plain == "" or plain:match("^%s*$") then
			return 0
		end

		local maxW = math.max(width - 24, 50)
		dummyLbl.Size = UDim2.fromOffset(maxW, 0)
		dummyLbl.Text = text          -- use original (with rich tags)
		return math.ceil(dummyLbl.TextBounds.Y)
	end

	local function relayout()
		local width = shell.AbsoluteSize.X
		if width < 20 then
			width = 280
		end

		local dh = measureHeight(desc, width)
		if dh == 0 then
			descLbl.Visible = false
			shell.Size = UDim2.new(1, 0, 0, 28)
		else
			descLbl.Visible = true
			descLbl.Size = UDim2.new(1, -24, 0, dh)
			shell.Size = UDim2.new(1, 0, 0, 28 + dh + 4)
		end
	end

	shell:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(relayout)
	end)

	task.defer(relayout)

	return {
		SetDesc = function(_, newDesc)
			desc = newDesc or ""
			descLbl.Text = desc
			task.defer(relayout)
		end,
		SetName = function(_, n)
			titleLbl.Text = n or ""
		end,
		SetTitle = function(_, n)
			titleLbl.Text = n or ""
		end,
	}
end

local function rgbToHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function hexToColor(hex)
	hex = tostring(hex or ""):gsub("#", "")
	if #hex ~= 6 then return nil end
	local r = tonumber(hex:sub(1, 2), 16)
	local g = tonumber(hex:sub(3, 4), 16)
	local b = tonumber(hex:sub(5, 6), 16)
	if not r or not g or not b then return nil end
	return Color3.fromRGB(r, g, b)
end

