				local hum = getHum()
				if hum then
					setHumanoidStates(true)
					hum.PlatformStand = false
					pcall(function() hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics) end)
				end
				if char then
					local anim = char:FindFirstChild("Animate")
					if anim then anim.Disabled = false end
				end
			end

			local function startTpWalk()
	tpwalking = false
	task.wait()
	tpwalking = true

	local loops = math.max(1, math.floor(tonumber(flySpeed) or 1))

	for _ = 1, loops do
		task.spawn(function()
			while tpwalking and flyOn do
				task.wait()

				local char = LP.Character
				local hum = char and char:FindFirstChildWhichIsA("Humanoid")

				if not (char and hum and hum.Parent) then
					break
				end

				if hum.MoveDirection.Magnitude > 0 then
					pcall(function()
						char:TranslateBy(hum.MoveDirection)
					end)
				end
			end
		end)
	end
end

			local function startFly()
				stopFly()
				local root = getFlyRoot()
				local hum = getHum()
				local char = LP.Character
				if not root or not hum or not char then return end

				flyOn = true
				flyLoop = true

				pcall(function()
					local anim = char:FindFirstChild("Animate")
					if anim then anim.Disabled = true end
					for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
						t:AdjustSpeed(0)
					end
				end)
				setHumanoidStates(false)
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Swimming) end)
				hum.PlatformStand = true

				flyBG = Instance.new("BodyGyro")
				flyBG.P = 9e4
				flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
				flyBG.CFrame = root.CFrame
				flyBG.Parent = root

				flyBV = Instance.new("BodyVelocity")
				flyBV.Velocity = Vector3.new(0, 0.1, 0)
				flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
				flyBV.Parent = root

				startTpWalk()

				task.spawn(function()
					local ctrl = { f = 0, b = 0, l = 0, r = 0 }
					local lastctrl = { f = 0, b = 0, l = 0, r = 0 }
					local maxspeed = 50
					local speed = 0

					while flyOn and flyLoop do
						root = getFlyRoot()
						hum = getHum()
						if not root or not hum or hum.Health <= 0 then break end

						ctrl.f = UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0
						ctrl.b = UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0
						ctrl.l = UserInputService:IsKeyDown(Enum.KeyCode.A) and -1 or 0
						ctrl.r = UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0

						local md = hum.MoveDirection
						if md.Magnitude > 0.05 then
							local cam = workspace.CurrentCamera
							if cam then
								local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
								local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
								if look.Magnitude > 0.001 then look = look.Unit end
								if right.Magnitude > 0.001 then right = right.Unit end
								local fwd = md:Dot(look)
								local side = md:Dot(right)
								if math.abs(fwd) > 0.05 then
									if fwd > 0 then ctrl.f = 1 else ctrl.b = -1 end
								end
								if math.abs(side) > 0.05 then
									if side > 0 then ctrl.r = 1 else ctrl.l = -1 end
								end
							end
						end

						if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
							speed = speed + 0.5 + (speed / maxspeed)
							if speed > maxspeed then speed = maxspeed end
						elseif speed ~= 0 then
							speed = speed - 1
							if speed < 0 then speed = 0 end
						end

						local camCF = workspace.CurrentCamera.CFrame
						if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
							flyBV.Velocity = (
								(camCF.LookVector * (ctrl.f + ctrl.b))
								+ ((camCF * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0)).Position - camCF.Position)
							) * speed
							lastctrl = { f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r }
						elseif speed ~= 0 then
							flyBV.Velocity = (
								(camCF.LookVector * (lastctrl.f + lastctrl.b))
								+ ((camCF * CFrame.new(lastctrl.l + lastctrl.r, (lastctrl.f + lastctrl.b) * 0.2, 0)).Position - camCF.Position)
							) * speed
						else
							flyBV.Velocity = Vector3.new(0, 0, 0)
						end

						local hrp = getHRP()
						if hrp then
							local upHeld = UserInputService:IsKeyDown(Enum.KeyCode.Space)
								or UserInputService:IsKeyDown(Enum.KeyCode.E)
								or flyMobileUp
							local downHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
								or UserInputService:IsKeyDown(Enum.KeyCode.Q)
								or flyMobileDown
							if upHeld then
								hrp.CFrame = hrp.CFrame * CFrame.new(0, 1, 0)
							elseif downHeld then
								hrp.CFrame = hrp.CFrame * CFrame.new(0, -1, 0)
							end
						end

						flyBG.CFrame = camCF * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * speed / maxspeed), 0, 0)
						hum.PlatformStand = true
					end

					if flyBV then pcall(function() flyBV:Destroy() end) flyBV = nil end
					if flyBG then pcall(function() flyBG:Destroy() end) flyBG = nil end
					tpwalking = false
					local h = getHum()
					if h then
						setHumanoidStates(true)
						h.PlatformStand = false
					end
					local c = LP.Character
					if c then
						local anim = c:FindFirstChild("Animate")
						if anim then anim.Disabled = false end
					end
				end)
			end

