local function getNotifyHost()
	local ok, hui = pcall(function()
		return gethui()
	end)
	if ok and hui then return hui end
	return player:WaitForChild("PlayerGui")
end

local notifyContainer = nil

local function ensureNotifyContainer()
	if notifyContainer and notifyContainer.Parent then
		return notifyContainer
	end
	local host = getNotifyHost()
	local screenGui = host:FindFirstChild("MonarchNotifyGui")
	if not screenGui then
		screenGui = Instance.new("ScreenGui")
		screenGui.Name = "MonarchNotifyGui"
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = true
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.DisplayOrder = 999999
		screenGui.Parent = host
	end
	local container = screenGui:FindFirstChild("NotificationsFrame")
	if not container then
		container = Instance.new("Frame")
		container.Name = "NotificationsFrame"
		container.Size = UDim2.new(0, 280, 1, -20)
		container.Position = UDim2.new(1, -290, 0, 10)
		container.BackgroundTransparency = 1
		container.ZIndex = 10000
		container.Parent = screenGui
		local listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 6)
		listLayout.VerticalAlignment = Enum.VerticalAlignment.Top
		listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		listLayout.Parent = container
	end
	notifyContainer = container
	return container
end

local function spawnNotification(titleText, descText, duration)
	duration = duration or 5
	local slideDuration = 0.4
	local spawnOffsetX = 450
	local isDismissed = false
	local parentContainer = ensureNotifyContainer()

	local gui = Instance.new("Frame")
	gui.Size = UDim2.new(0, 260, 0, 55)
	gui.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	gui.BackgroundTransparency = 1
	gui.BorderSizePixel = 0
	gui.ClipsDescendants = true
	gui.ZIndex = 10001

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = gui

	local accentBar = Instance.new("Frame")
	accentBar.Size = UDim2.new(0, 3, 1, -16)
	accentBar.Position = UDim2.new(0, 0, 0, 8)
	accentBar.BackgroundColor3 = COLORS.accent
	accentBar.BackgroundTransparency = 0.3
	accentBar.BorderSizePixel = 0
	accentBar.ZIndex = 10002
	local accentCorner = Instance.new("UICorner")
	accentCorner.CornerRadius = UDim.new(1, 0)
	accentCorner.Parent = accentBar
	accentBar.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -25, 0, 16)
	title.Position = UDim2.new(0, 14, 0, 6)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 12
	title.TextColor3 = Color3.fromRGB(240, 240, 240)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.RichText = true
	title.Text = tostring(titleText or "")
	title.ZIndex = 10002
	title.Parent = gui

	local desc = Instance.new("TextLabel")
	desc.Size = UDim2.new(1, -25, 0, 0)
	desc.Position = UDim2.new(0, 14, 0, 22)
	desc.BackgroundTransparency = 1
	desc.Font = Enum.Font.Gotham
	desc.TextSize = 10
	desc.TextColor3 = Color3.fromRGB(160, 160, 160)
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextYAlignment = Enum.TextYAlignment.Top
	desc.TextWrapped = true
	desc.RichText = true
	desc.Text = tostring(descText or "")
	desc.ZIndex = 10002
	desc.Parent = gui

	local plainDesc = tostring(descText or ""):gsub("<[^>]+>", "")
	local bounds = TextService:GetTextSize(plainDesc, 10, Enum.Font.Gotham, Vector2.new(230, 10000))
	local h = math.max(55, bounds.Y + 42)
	gui.Size = UDim2.new(0, 260, 0, h)
	desc.Size = UDim2.new(1, -25, 0, math.max(bounds.Y, 12))

	local dotsContainer = Instance.new("Frame")
	dotsContainer.Size = UDim2.new(0, 40, 0, 12)
	dotsContainer.Position = UDim2.new(0, 14, 1, -16)
	dotsContainer.BackgroundTransparency = 1
	dotsContainer.ZIndex = 10002
	dotsContainer.Parent = gui

	local dots = {}
	for i = 1, 3 do
		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, 4, 0, 4)
		dot.Position = UDim2.new(0, (i - 1) * 10, 0.5, -2)
		dot.BackgroundColor3 = COLORS.accent
		dot.BackgroundTransparency = 0.3
		dot.BorderSizePixel = 0
		dot.ZIndex = 10003
		local dc = Instance.new("UICorner")
		dc.CornerRadius = UDim.new(1, 0)
		dc.Parent = dot
		dot.Parent = dotsContainer
		table.insert(dots, dot)
	end

	local timerBarBg = Instance.new("Frame")
	timerBarBg.Size = UDim2.new(1, 0, 0, 2)
	timerBarBg.Position = UDim2.new(0, 0, 1, -2)
	timerBarBg.BackgroundTransparency = 1
	timerBarBg.BorderSizePixel = 0
	timerBarBg.ZIndex = 10002
	timerBarBg.Parent = gui

	local timerBar = Instance.new("Frame")
	timerBar.Size = UDim2.new(1, 0, 1, 0)
	timerBar.BackgroundColor3 = COLORS.accent
	timerBar.BackgroundTransparency = 0.3
	timerBar.BorderSizePixel = 0
	timerBar.ZIndex = 10003
	local tbc = Instance.new("UICorner")
	tbc.CornerRadius = UDim.new(1, 0)
	tbc.Parent = timerBar
	timerBar.Parent = timerBarBg

	gui.Position = UDim2.new(0, spawnOffsetX, 0, 0)
	gui.Parent = parentContainer

	local function dismiss()
		if isDismissed then return end
		isDismissed = true
		local out = TweenService:Create(gui, TweenInfo.new(slideDuration, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Position = UDim2.new(0, spawnOffsetX, 0, 0),
			BackgroundTransparency = 1,
		})
		out:Play()
		out.Completed:Wait()
		gui:Destroy()
	end

	TweenService:Create(gui, TweenInfo.new(slideDuration, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 0.15,
	}):Play()

	TweenService:Create(timerBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0),
	}):Play()

	task.spawn(function()
		local interval = duration / 3
		for _, dot in ipairs(dots) do
			task.wait(interval)
			if isDismissed then break end
			TweenService:Create(dot, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end)

	task.delay(duration, dismiss)
end

local function Notify(titleText, descText, duration)
	task.spawn(function()
		spawnNotification(titleText, descText, duration)
	end)
end

